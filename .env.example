# Copy to .env.local and fill in. Restart `npm run dev` after editing.

# Supabase → Project Settings → API (Data API) → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB (movie search) — either the v3 "API Key" or the v4 "API Read Access Token"
VITE_TMDB_KEY=

# RAWG (game search) — https://rawg.io/apidocs
VITE_RAWG_API_KEY=

# Optional: public site URL for social previews (og:image). On Vercel this is detected automatically.
VITE_SITE_URL=
